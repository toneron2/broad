# ESN Project .gitignore

# OS Files
.DS_Store
Thumbs.db
desktop.ini

# Editor directories and files
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dependencies
node_modules/
vendor/
venv/
env/

# Build outputs
build/
dist/
out/
*.apk
*.aab
aosp-build/

# Environment files (contains secrets)
.env
.env.local
.env.*.local
credentials.json
service-account-key.json

# Temporary files
tmp/
temp/
*.tmp

# Test coverage
coverage/
*.coverage
.pytest_cache/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Android/AOSP specific
*.iml
.gradle
local.properties
.externalNativeBuild
.cxx

# Cloud deployment
.gcloudignore
terraform.tfstate*
.terraform/

# Keep these docs checked in (NOT ignored)
# seeds/
# docs/
# CLAUDE.md
# README.md
